# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
DATABASE_URL=./data/app.db
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Only behind a reverse proxy that overwrites this header with the real client IP (e.g. x-real-ip).
# Leave unset when the API is reachable directly; client-sent X-Forwarded-For is never trusted.
# TRUSTED_PROXY_HEADER=
# Set by the Docker image; only needed to run the bundled build by hand:
# WEB_DIST=/path/to/apps/web/dist     (serve the built web app from the API)
# MIGRATIONS_DIR=/path/to/drizzle
