{
  "name": "job-tracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter './apps/*' test",
    "test:e2e": "bun run --filter @job-tracker/e2e test:e2e",
    "dev": "bun run --parallel --filter './apps/*' dev"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
